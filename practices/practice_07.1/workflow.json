    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nif (body.pull_request) {\n  return [{\n    json: {\n      repo: body.pull_request.base.repo.full_name,\n      pr_number: body.number,\n      command: 'opened',\n      model_route: 'primary'\n    }\n  }];\n}\n\nconst commentBody = (body.comment?.body || '').trim();\nreturn [{\n  json: {\n    repo: body.repository.full_name,\n    pr_number: body.issue.number,\n    command: commentBody,\n    model_route: commentBody === '/make_other_ai_review' ? 'other' : 'primary'\n  }\n}];"
      },
