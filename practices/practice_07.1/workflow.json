      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Get PR Metadata').first().json.base.repo.full_name }}/pulls/{{ $('Get PR Metadata').first().json.number }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
