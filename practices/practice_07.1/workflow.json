      "id": "ebc36ad8-47f7-4b0a-a88e-9ab901f4f14c",
      "name": "Get PR Diff (Primary)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        960,
        160
      ],
      "typeVersion": 4.2,
      "credentials": {
        "httpBearerAuth": {
          "id": "l3rvJZQBJ98IxcSb",
          "name": "Bearer Auth account 141"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst results = [];\nconst fileBlocks = raw.split(/^diff --git /m).slice(1);\n\nfor (const fileBlock of fileBlocks) {\n  const lines = fileBlock.split(/\\r?\\n/);\n  let oldPath = null;\n  let newPath = null;\n  for (const l of lines) {\n    if (l.startsWith('--- ')) oldPath = l.slice(4).replace(/^a\\//, '').trim();\n    else if (l.startsWith('+++ ')) newPath = l.slice(4).replace(/^b\\//, '').trim();\n    else if (l.startsWith('@@ ')) break;\n  }\n  if (!newPath && !oldPath) continue;\n  const filePath = newPath && newPath !== '/dev/null' ? newPath : oldPath;\n\n  const hunkMatches = [...fileBlock.matchAll(/^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@.*$/gm)];\n  for (let i = 0; i < hunkMatches.length; i++) {\n    const m = hunkMatches[i];\n    const startIdx = m.index;\n    const endIdx = i + 1 < hunkMatches.length ? hunkMatches[i + 1].index : fileBlock.length;\n    const hunkText = fileBlock.slice(startIdx, endIdx).trimEnd();\n    const hunkLines = hunkText.split(/\\r?\\n/).slice(1);\n\n    let oldLine = parseInt(m[1], 10);\n    let newLine = parseInt(m[3], 10);\n    let lastAddedNew = null;\n    let lastContextNew = null;\n    let lastDeletedOld = null;\n\n    for (const hl of hunkLines) {\n      if (hl.startsWith('\\\\ No newline')) continue;\n      if (hl.startsWith('+')) {\n        lastAddedNew = newLine;\n        newLine++;\n      } else if (hl.startsWith('-')) {\n        lastDeletedOld = oldLine;\n        oldLine++;\n      } else {\n        lastContextNew = newLine;\n        oldLine++;\n        newLine++;\n      }\n    }\n\n    let side = 'RIGHT';\n    let targetLine = lastAddedNew ?? lastContextNew;\n    if (targetLine === null || targetLine === undefined) {\n      side = 'LEFT';\n      targetLine = lastDeletedOld ?? 1;\n    }\n\n    results.push({\n      json: {\n        path: filePath,\n        line: targetLine,\n        side,\n        hunk: hunkText\n      }\n    });\n  }\n}\n\nreturn results;"
      },
