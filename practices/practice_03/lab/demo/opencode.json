{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "local-guide",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local agent (qwen3.5:4b, 8k)",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "itmo": {
          "name": "ITMO chat (qwen3.5:4b, 4k)",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant for QUESTIONS.md checks",
      "mode": "primary",
      "model": "ollama/itmo-agent",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  }
}
