{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "vsellm/openai/gpt-5",
  "small_model": "vsellm/openai/gpt-5",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "mcp": {
    "notify": {
      "type": "local",
      "command": ["python", "mcp/notify_mcp.py"],
      "enabled": true
    }
  },
  "plugin": ["./.opencode/plugins/check-after-edit.js"],
  "permission": {
    "skill": {
      "notify-tests": "allow"
    }
  }
}
