      "position": [
        -20,
        240
      ],
      "typeVersion": 4.2,
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.repo }}/issues?state=all&labels=feature&since={{ $('Config').first().json.since }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
