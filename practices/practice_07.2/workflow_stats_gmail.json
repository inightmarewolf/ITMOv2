        -900,
        240
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst sinceDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    repo: 'inightmarewolf/practice_7.1',\n    since: sinceDate.toISOString(),\n    week_start: now.toISOString().slice(0, 10)\n  }\n}];"
      },
      "id": "33333333-3333-4333-8333-333333333302",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "position": [
        -680,
        240
      ],
      "typeVersion": 2
    },
    {
