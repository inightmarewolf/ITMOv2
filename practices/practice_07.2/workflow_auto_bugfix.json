      "id": "44444444-4444-4444-8444-444444444421",
      "name": "List Repo Files",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -660,
        240
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Filter Issue Opened').first().json.body.issue;\nconst text = ((issue.title || '') + ' ' + (issue.body || '')).toLowerCase();\nconst files = $input.all().map(i => i.json).filter(f => f && f.type === 'file');\nconst codeFiles = files.filter(f => /\\.(py|js|ts|tsx|go|java)$/i.test(f.name));\nconst pool = codeFiles.length ? codeFiles : files.filter(f => !/readme/i.test(f.name));\nconst matched = pool.find(f => text.includes(f.name.toLowerCase())) || pool[0] || files[0];\n\nif (!matched) {\n  throw new Error('No files found in repository main branch');\n}\n\nreturn [{\n  json: {\n    target_path: matched.path,\n    all_files: files.map(f => f.path)\n  }\n}];"
      },
      "id": "44444444-4444-4444-8444-444444444422",
      "name": "Pick Target File",
      "type": "n8n-nodes-base.code",
      "position": [
        -440,
        240
      ],
      "typeVersion": 2,
      "executeOnce": true
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Filter Issue Opened').first().json.body.repository.full_name }}/contents/{{ $json.target_path }}?ref=main",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444404",
      "name": "Get Target File from Main",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -220,
        240
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Filter Issue Opened').first().json.body.issue;\nconst repo = $('Filter Issue Opened').first().json.body.repository.full_name;\nconst mainSha = $('Get Main Branch Ref').first().json.object.sha;\nconst fileData = $input.first().json;\nconst decodedCode = Buffer.from((fileData.content || '').replace(/\\n/g, ''), 'base64').toString('utf8');\nconst branchName = `fix/issue-${issue.number}-${Date.now().toString().slice(-4)}`;\n\nreturn [{\n  json: {\n    repo,\n    issue_number: issue.number,\n    issue_title: issue.title || '',\n    issue_body: issue.body || '',\n    main_sha: mainSha,\n    file_path: fileData.path,\n    file_sha: fileData.sha,\n    current_code: decodedCode,\n    branch_name: branchName\n  }\n}];"
      },
      "id": "44444444-4444-4444-8444-444444444405",
      "name": "Decode Source Code",
      "type": "n8n-nodes-base.code",
      "position": [
        0,
        240
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты опытный Python-разработчик. На основе bug report-а исправь ошибку в файле `{{ $json.file_path }}`.\n\nBug report (#{{ $json.issue_number }}):\nЗаголовок: {{ $json.issue_title }}\nОписание: {{ $json.issue_body }}\n\nТекущий код файла `{{ $json.file_path }}`:\n```python\n{{ $json.current_code }}\n```\n\nВерни полный исправленный код файла в поле `fixed_code`, краткое сообщение коммита в `commit_message` и заголовок PR в `pr_title`.",
        "hasOutputParser": true,
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444406",
      "name": "AI Bug Fixer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        240,
        240
      ],
      "typeVersion": 1.5
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openai/gpt-5.2",
          "mode": "list",
          "cachedResultName": "openai/gpt-5.2"
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444407",
      "name": "OpenAI Fixer Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        160,
        460
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fixed_code\": { \"type\": \"string\" },\n    \"commit_message\": { \"type\": \"string\" },\n    \"pr_title\": { \"type\": \"string\" }\n  },\n  \"required\": [\"fixed_code\", \"commit_message\", \"pr_title\"]\n}"
      },
      "id": "44444444-4444-4444-8444-444444444408",
      "name": "Fixer Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        380,
        460
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Decode Source Code').first().json;\nconst out = $input.first().json.output ?? $input.first().json;\nconst encoded = Buffer.from(out.fixed_code, 'utf8').toString('base64');\n\nreturn [{\n  json: {\n    ...ctx,\n    fixed_code: out.fixed_code,\n    fixed_code_base64: encoded,\n    commit_message: out.commit_message || `fix: resolve issue #${ctx.issue_number}`,\n    pr_title: out.pr_title || `Fix #${ctx.issue_number}: ${ctx.issue_title}`\n  }\n}];"
      },
